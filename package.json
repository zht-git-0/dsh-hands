{
  "name": "dsh-hands",
  "version": "2.0.0",
  "type": "module",
  "description": "把本机的 agy 和 codex 两个命令行智能体接成 DSH 工具：agy 管文案写作，codex 管写代码。自用版，不带安装向导。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

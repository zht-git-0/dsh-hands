{
  "name": "dsh-hands",
  "version": "2.6.23",
  "type": "module",
  "description": "把本机的 agy、codex、claude、opencode 四个命令行智能体接成 DSH 工具，并在对话右侧边栏提供实时「手下任务」流式看板。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./stream": "./stream.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "stream.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skill/",
    "assets/icons/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "author": "dsh-hands contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/zht-git-0/dsh-hands.git"
  },
  "homepage": "https://github.com/zht-git-0/dsh-hands#readme",
  "bugs": {
    "url": "https://github.com/zht-git-0/dsh-hands/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "codex",
    "claude",
    "opencode",
    "antigravity",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  }
}
